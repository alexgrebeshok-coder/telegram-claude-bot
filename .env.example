# Telegram Bot
BOT_TOKEN=your_telegram_bot_token_here
ADMIN_IDS=123456789

# Claude Code CLI
# Рабочая директория для выполнения задач (где находятся ваши проекты)
CLAUDE_WORKING_DIR=/Users/your_username/Projects

# Таймаут выполнения задачи в секундах (по умолчанию 10 минут)
CLAUDE_TIMEOUT=600

# Database
DATABASE_URL=sqlite:///claude_bot.db

# Logging
LOG_LEVEL=INFO
